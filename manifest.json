{
  "manifest_version": 3,
  "name": "QR Code",
  "version": "1.0.0",
  "description": "Generate a QR code for the current page, a link, an image, or selected text. Works entirely offline.",
  "author": "Michael Riddle",

  "permissions": ["activeTab", "contextMenus", "storage"],

  "background": {
    "scripts": ["src/background.js"],
    "type": "module"
  },

  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "Generate QR Code",
    "default_icon": {
      "16": "icons/icon.svg",
      "32": "icons/icon.svg",
      "48": "icons/icon.svg",
      "128": "icons/icon.svg"
    }
  },

  "icons": {
    "16": "icons/icon.svg",
    "32": "icons/icon.svg",
    "48": "icons/icon.svg",
    "96": "icons/icon.svg",
    "128": "icons/icon.svg"
  },

  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": false
  },

  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+Q",
        "mac": "Command+Shift+Q"
      },
      "description": "Generate QR Code for the current page"
    }
  },

  "browser_specific_settings": {
    "gecko": {
      "id": "qr@riddlemd",
      "strict_min_version": "115.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    },
    "gecko_android": {
      "strict_min_version": "115.0"
    }
  }
}
