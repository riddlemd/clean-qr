{
  "manifest_version": 3,
  "name": "Clean QR",
  "version": "1.0.1",
  "description": "Generate a QR code for the current page, a link, an image, or selected text. Works entirely offline.",
  "author": "Michael Riddle",
  "homepage_url": "https://github.com/riddlemd/clean-qr",

  "permissions": ["activeTab", "menus", "storage", "clipboardWrite"],

  "background": {
    "scripts": ["src/background.js"],
    "type": "module"
  },

  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "Generate QR Code",
    "default_icon": {
      "16": "icons/icon.svg",
      "32": "icons/icon.svg",
      "48": "icons/icon.svg",
      "128": "icons/icon.svg"
    },
    "theme_icons": [
      {
        "light": "icons/icon-light.svg",
        "dark": "icons/icon.svg",
        "size": 16
      },
      {
        "light": "icons/icon-light.svg",
        "dark": "icons/icon.svg",
        "size": 32
      }
    ]
  },

  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },

  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": false
  },

  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+Q"
      },
      "description": "Generate QR Code for the current page"
    }
  },

  "browser_specific_settings": {
    "gecko": {
      "id": "clean-qr@riddlemd",
      "strict_min_version": "115.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    },
    "gecko_android": {
      "strict_min_version": "120.0"
    }
  }
}
